{
  "MailboxFolder": "Inbox\\dmarcreports",
  "OutputRoot": ".\\Runs",
  "Days": 7,
  "MessageFilter": "UnreadOnly",
  "MarkAsRead": false,
  "ExistingFileAction": "Skip",
  "EnableGeoLookup": false,
  "UseGeoCache": true,
  "GeoCachePath": ".\\GEOIP.json",
  "GeoProvider": "ipinfo",
  "GeoApiBaseUri": "https://ipinfo.io",
  "GeoApiToken": null,
  "GeoApiTokenEnvName": "DMARC_REPORTER_IPINFO_TOKEN",
  "GeoApiTokenSecretName": "DMARCReporter-IpInfoToken",
  "GeoDelayMilliseconds": 250,
  "ForceGeoRefresh": false,
  "CreateCsvReports": true,
  "CreateHtmlReport": true,
  "CreateDashboard": true,
  "KeepRawAttachments": true
}
